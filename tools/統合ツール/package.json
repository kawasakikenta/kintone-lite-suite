{
  "name": "kintone-unified-suite",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "check": "npm run typecheck && npm run typecheck:strict && npm run build",
    "test": "npm run check"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
