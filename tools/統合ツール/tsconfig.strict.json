{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/types/**/*.ts",
    "src/types/uiRefs.ts",
    "src/constants.ts",
    "src/state.ts",
    "src/utils.ts",
    "src/api.ts",
    "src/diff/types.ts",
    "src/diff/filter.ts",
    "src/diff/engine.ts",
    "src/diff/enrich.ts",
    "src/diff/export.ts",
    "src/diff/category-view.ts",
    "src/ui/components.ts",
    "src/tabs/field.ts",
    "src/handlers/diffFocus.ts",
    "src/entries/litePanelHelpers.ts"
  ]
}
