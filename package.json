{
  "name": "kintone",
  "version": "1.0.0",
  "description": "- 画像一括ダウンロード: `image_bulk_download.js`   - 登録情報: `snippets_registry.json`",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "snippet": "node scripts/build-snippet.js",
    "build:kintone-calendar": "vite build --config plugins/KintoneCalendar/vite.config.mjs",
    "check:kintone-calendar": "tsc --noEmit --project plugins/KintoneCalendar/tsconfig.json",
    "test:kintone-calendar": "node --test plugins/KintoneCalendar/tests/*.test.mjs",
    "package:kintone-calendar": "kintone-plugin-packer --ppk plugins/KintoneCalendar.ppk plugins/KintoneCalendar --out plugins/KintoneCalendar.zip",
    "mcp:playwright": "node node_modules/@playwright/mcp/cli.js --browser=chrome --output-dir=.playwright-mcp --save-session",
    "verify:playwright-mcp": "node scripts/verify-playwright-mcp.cjs",
    "build:field-transfer": "npm --prefix plugins/FieldTransfer run build",
    "test:field-transfer": "npm --prefix plugins/FieldTransfer test",
    "package:field-transfer": "npm run build:field-transfer && kintone-plugin-packer --ppk plugins/FieldTransfer.ppk plugins/FieldTransfer --out plugins/FieldTransfer.zip",
    "build:simple-task-board": "node plugins/SimpleTaskBoard/build-desktop.js",
    "package:simple-task-board": "npm run build:simple-task-board && kintone-plugin-packer --ppk plugins/SimpleTaskBoard.ppk plugins/SimpleTaskBoard --out plugins/SimpleTaskBoard.zip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawasakikenta/kintone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kawasakikenta/kintone/issues"
  },
  "homepage": "https://github.com/kawasakikenta/kintone#readme",
  "devDependencies": {
    "@kintone/plugin-packer": "^9.1.0",
    "@playwright/mcp": "^0.0.70",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "*",
    "@rolldown/binding-linux-x64-gnu": "*",
    "@rolldown/binding-win32-x64-msvc": "*"
  }
}
