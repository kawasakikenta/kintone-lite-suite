{
  "name": "kintone-tools",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawasakikenta/kintone-tools.git"
  },
  "bugs": {
    "url": "https://github.com/kawasakikenta/kintone-tools/issues"
  },
  "homepage": "https://github.com/kawasakikenta/kintone-tools#readme",
  "description": "kintone の設定比較・設計・データ運用を支援するブラウザツール集",
  "type": "commonjs",
  "scripts": {
    "setup": "npm --prefix tools/統合ツール ci",
    "build": "npm run build:unified",
    "build:unified": "npm --prefix tools/統合ツール run build",
    "build:excel-kaiseki": "node tools/standalone/build-excel-kaiseki.js",
    "check": "npm --prefix tools/統合ツール run check",
    "typecheck": "npm --prefix tools/統合ツール run typecheck",
    "typecheck:strict": "npm --prefix tools/統合ツール run typecheck:strict",
    "test": "npm run test:unit",
    "test:unit": "npm --prefix tools/統合ツール run test:unit",
    "test:output-layouts": "node tools/test-harness/run-output-layouts.mjs",
    "test:diff-multi-dom": "node tools/test-harness/run-diff-lite-multi-dom.cjs",
    "test:diff-compare": "node tools/test-harness/run-diff-lite-compare.cjs",
    "test:er-compare": "node tools/test-harness/run-er-diagram-compare.cjs",
    "snippet": "node scripts/build-snippet.js",
    "mcp:playwright": "node node_modules/@playwright/mcp/cli.js --browser=chrome --output-dir=.playwright-mcp --save-session",
    "verify:playwright-mcp": "node scripts/verify-playwright-mcp.cjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.70"
  }
}
